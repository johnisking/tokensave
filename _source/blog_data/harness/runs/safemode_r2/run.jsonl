st speed = Math.hypot(ball.dx, ball.dy);\n    const angle = Math.max(-1, Math.min(1, hit)) * (Math.PI / 3);\n    ball.dx = speed * Math.sin(angle);\n    ball.dy = -speed * Math.cos(angle);\n    ball.y = paddle.y - ball.r;\n  }\n\n  // Bricks\n  for (const b of bricks) {\n    if (b.hp <= 0) continue;\n    const cx = Math.max(b.x, Math.min(ball.x, b.x + BRICK_W));\n    const cy = Math.max(b.y, Math.min(ball.y, b.y + BRICK_H));\n    const ddx = ball.x - cx, ddy = ball.y - cy;\n    if (ddx * ddx + ddy * ddy <= ball.r * ball.r) {\n      // Decide bounce axis by overlap\n      const overlapX = Math.min(ball.x + ball.r - b.x, b.x + BRICK_W - (ball.x - ball.r));\n      const overlapY = Math.min(ball.y + ball.r - b.y, b.y + BRICK_H - (ball.y - ball.r));\n      if (overlapX < overlapY) ball.dx = -ball.dx; else ball.dy = -ball.dy;\n      b.hp--;\n      score += b.hp <= 0 ? 10 * b.type : 5;\n      if (bricks.every(br => br.hp <= 0)) {\n        state = level + 1 < LEVELS.length ? 'levelclear' : 'win';\n        if (state === 'win') score += lives * 100;\n      }\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction drawText(t, y, size = 28, color = '#fff') {\n  ctx.fillStyle = color;\n  ctx.font = `bold ${size}px sans-serif`;\n  ctx.textAlign = 'center';\n  ctx.fillText(t, W / 2, y);\n}\n\nfunction draw() {\n  ctx.clearRect(0, 0, W, H);\n\n  // HUD\n  ctx.fillStyle = '#fff';\n  ctx.font = '18px sans-serif';\n  ctx.textAlign = 'left';\n  ctx.fillText('Score: ' + score, 12, 28);\n  ctx.textAlign = 'center';\n  ctx.fillText('Level ' + (level + 1) + ' / ' + LEVELS.length, W / 2, 28);\n  ctx.textAlign = 'right';\n  ctx.fillText('Lives: ' + '❤'.repeat(Math.max(0, lives)), W - 12, 28);\n\n  // Bricks\n  for (const b of bricks) {\n    if (b.hp <= 0) continue;\n    ctx.fillStyle = (b.type === 3 && b.hp < 3) ? (b.hp === 1 ? '#ffccbc' : '#ffab91') : COLORS[b.type];\n    if (b.type === 2 && b.hp === 1) ctx.fillStyle = '#c8e6c9';\n    ctx.fillRect(b.x, b.y, BRICK_W, BRICK_H);\n    ctx.strokeStyle = 'rgba(0,0,0,0.4)';\n    ctx.strokeRect(b.x + 0.5, b.y + 0.5, BRICK_W - 1, BRICK_H - 1);\n  }\n\n  // Paddle\n  ctx.fillStyle = '#eee';\n  ctx.fillRect(paddle.x, paddle.y, paddle.w, paddle.h);\n\n  // Ball\n  if (state === 'play' || state === 'paused') {\n    ctx.beginPath();\n    ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);\n    ctx.fillStyle = '#ffeb3b';\n    ctx.fill();\n  }\n\n  // Overlays\n  const sub = 'Press Space or Click';\n  if (state === 'start') {\n    drawText('BRICK BREAKER', H / 2 - 20, 40);\n    drawText(sub + ' to start', H / 2 + 25, 18, '#aaa');\n  } else if (state === 'paused') {\n    drawText('PAUSED', H / 2, 36);\n  } else if (state === 'levelclear') {\n    drawText('LEVEL ' + (level + 1) + ' CLEAR!', H / 2 - 10, 36, '#81c784');\n    drawText(sub + ' for next level', H / 2 + 30, 18, '#aaa');\n  } else if (state === 'gameover') {\n    drawText('GAME OVER', H / 2 - 10, 40, '#e57373');\n    drawText('Final score: ' + score + ' — ' + sub + ' to restart', H / 2 + 30, 18, '#aaa');\n  } else if (state === 'win') {\n    drawText('YOU WIN!', H / 2 - 10, 40, '#ffeb3b');\n    drawText('Final score: ' + score + ' — ' + sub + ' to play again', H / 2 + 30, 18, '#aaa');\n  } else if (state === 'play' && ball.stuck) {\n    drawText(sub + ' to launch', H / 2 + 60, 16, '#888');\n  }\n}\n\nfunction loop() {\n  update();\n  draw();\n  requestAnimationFrame(loop);\n}\n\nloadLevel(0);\nloop();\n</script>\n</body>\n</html>\n"}}}
