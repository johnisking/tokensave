OLORS.length]\n      });\n    });\n  });\n  resetBall();\n}\n\nfunction resetBall() {\n  paddle.x = W / 2 - paddle.w / 2;\n  ball.stuck = true;\n  ball.dx = 0; ball.dy = 0;\n  placeBallOnPaddle();\n}\n\nfunction placeBallOnPaddle() {\n  ball.x = paddle.x + paddle.w / 2;\n  ball.y = paddle.y - ball.r - 1;\n}\n\nfunction launch() {\n  if (!ball.stuck) return;\n  const speed = 5.5 + level * 1.2;\n  const angle = (Math.random() * 0.6 - 0.3) - Math.PI / 2;\n  ball.dx = Math.cos(angle) * speed;\n  ball.dy = Math.sin(angle) * speed;\n  ball.stuck = false;\n}\n\nfunction newGame() {\n  level = 0; score = 0; lives = 3;\n  loadLevel(level);\n  state = 'playing';\n}\n\nfunction action() {\n  if (state === 'start' || state === 'gameover' || state === 'win') newGame();\n  else if (state === 'levelclear') { level++; loadLevel(level); state = 'playing'; }\n  else if (state === 'playing') launch();\n  else if (state === 'paused') state = 'playing';\n}\n\n// Input\ndocument.addEventListener('keydown', e => {\n  keys[e.key] = true;\n  if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); action(); }\n  if (e.key === 'p' || e.key === 'P' || e.key === 'Escape') {\n    if (state === 'playing') state = 'paused';\n    else if (state === 'paused') state = 'playing';\n  }\n  if (['ArrowLeft', 'ArrowRight'].includes(e.key)) e.preventDefault();\n});\ndocument.addEventListener('keyup', e => { keys[e.key] = false; });\ncanvas.addEventListener('mousemove', e => {\n  const rect = canvas.getBoundingClientRect();\n  const mx = (e.clientX - rect.left) * (W / rect.width);\n  paddle.x = Math.max(0, Math.min(W - paddle.w, mx - paddle.w / 2));\n});\ncanvas.addEventListener('mousedown', e => { e.preventDefault(); action(); });\n\nfunction update() {\n  if (state !== 'playing') return;\n\n  if (keys['ArrowLeft'] || keys['a'] || keys['A']) paddle.x -= paddle.speed;\n  if (keys['ArrowRight'] || keys['d'] || keys['D']) paddle.x += paddle.speed;\n  paddle.x = Math.max(0, Math.min(W - paddle.w, paddle.x));\n\n  if (ball.stuck) { placeBallOnPaddle(); return; }\n\n  // Sub-step to avoid tunneling\n  const steps = Math.ceil(Math.max(Math.abs(ball.dx), Math.abs(ball.dy)) / 4);\n  for (let s = 0; s < steps; s++) {\n    ball.x += ball.dx / steps;\n    ball.y += ball.dy / steps;\n    if (collide()) break;\n  }\n}\n\nfunction collide() {\n  // Walls\n  if (ball.x - ball.r < 0) { ball.x = ball.r; ball.dx = Math.abs(ball.dx); }\n  if (ball.x + ball.r > W) { ball.x = W - ball.r; ball.dx = -Math.abs(ball.dx); }\n  if (ball.y - ball.r < 0) { ball.y = ball.r; ball.dy = Math.abs(ball.dy); }\n\n  // Bottom: lose life\n  if (ball.y - ball.r > H) {\n    lives--;\n    if (lives <= 0) state = 'gameover';\n    else resetBall();\n    return true;\n  }\n\n  // Paddle\n  if (ball.dy > 0 &&\n      ball.y + ball.r >= paddle.y && ball.y + ball.r <= paddle.y + paddle.h + ball.dy &&\n      ball.x >= paddle.x - ball.r && ball.x <= paddle.x + paddle.w + ball.r) {\n    const hit = (ball.x - (paddle.x + paddle.w / 2)) / (paddle.w / 2); // -1..1\n    const clamped = Math.max(-1, Math.min(1, hit));\n    const speed = Math.hypot(ball.dx, ball.dy);\n    const angle = clamped * (Math.PI / 3); // up to 60deg\n    ball.dx = Math.sin(angle) * speed;\n    ball.dy = -Math.cos(angle) * speed;\n    ball.y = paddle.y - ball.r;\n    return true;\n  }\n\n  // Bricks\n  for (let i = 0; i < bricks.length; i++) {\n    const b = bricks[i];\n    const cx = Math.max(b.x, Math.min(ball.x, b.x + BRICK_W));\n    const cy = Math.max(b.y, Math.min(ball.y, b.y + BRICK_H));\n    const ddx = ball.x - cx, ddy = ball.y - cy;\n    if (ddx * ddx + ddy * ddy <= ball.r * ball.r) {\n      // Determine bounce axis by penetration\n      const overlapX = Math.min(ball.x + ball.r - b.x, b.x + BRICK_W - (ball.x - ball.r));\n      const overlapY = Math.min(ball.y + ball.r - b.y, b.y + BRICK_H - (ball.y - ball.r));\n      if (overlapX < overlapY) ball.dx = -ball.dx; else ball.dy = -ball.dy;\n\n      b.hp--;\n      if (b.hp <= 0) {\n        score += 10 * b.maxHp * (level + 1);\n        bricks.splice(i, 1);\n      } else {\n        score += 5;\n      }\n      if (bricks.length === 0) {\n        state = level < LEVELS.length - 1 ? 'levelclear' : 'win';\n      }\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction drawRoundRect(x, y, w, h, r) {\n  ctx.beginPath();\n  ctx.moveTo(x + r, y);\n  ctx.arcTo(x + w, y, x + w, y + h, r);\n  ctx.arcTo(x + w, y + h, x, y + h, r);\n  ctx.arcTo(x, y + h, x, y, r);\n  ctx.arcTo(x, y, x + w, y, r);\n  ctx.closePath();\n  ctx.fill();\n}\n\nfunction drawOverlay(title, sub) {\n  ctx.fillStyle = 'rgba(0,0,0,0.65)';\n  ctx.fillRect(0, 0, W, H);\n  ctx.fillStyle = '#fff';\n  ctx.textAlign = 'center';\n  ctx.font = 'bold 48px sans-serif';\n  ctx.fillText(title, W / 2, H / 2 - 10);\n  ctx.font = '20px sans-serif';\n  ctx.fillText(sub, W / 2, H / 2 + 30);\n}\n\nfunction draw() {\n  ctx.clearRect(0, 0, W, H);\n\n  // HUD\n  ctx.fillStyle = '#fff';\n  ctx.font = '20px sans-serif';\n  ctx.textAlign = 'left';\n  ctx.fillText('Score: ' + score, 16, 32);\n  ctx.textAlign = 'center';\n  ctx.fillText('Level ' + (level + 1) + ' / ' + LEVELS.length, W / 2, 32);\n  ctx.textAlign = 'right';\n  ctx.fillText('Lives: ' + '♥'.repeat(Math.max(0, lives)), W - 16, 32);\n\n  // Bricks\n  for (const b of bricks) {\n    ctx.fillStyle = b.color;\n    ctx.globalAlpha = b.hp < b.maxHp ? 0.5 : 1;\n    drawRoundRect(b.x, b.y, BRICK_W, BRICK_H, 4);\n    if (b.maxHp > 1 && b.hp === b.maxHp) {\n      ctx.strokeStyle = '#fff';\n      ctx.lineWidth = 2;\n      ctx.strokeRect(b.x + 3, b.y + 3, BRICK_W - 6, BRICK_H - 6);\n    }\n    ctx.globalAlpha = 1;\n  }\n\n  // Paddle\n  ctx.fillStyle = '#ecf0f1';\n  drawRoundRect(paddle.x, paddle.y, paddle.w, paddle.h, 7);\n\n  // Ball\n  ctx.beginPath();\n  ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);\n  ctx.fillStyle = '#fff';\n  ctx.fill();\n\n  if (state === 'playing' && ball.stuck) {\n    ctx.fillStyle = '#aaa';\n    ctx.textAlign = 'center';\n    ctx.font = '18px sans-serif';\n    ctx.fillText('Click or press Space to launch', W / 2, H / 2 + 80);\n  }\n\n  if (state === 'start') drawOverlay('BRICK BREAKER', 'Click or press Space to start');\n  else if (state === 'paused') drawOverlay('PAUSED', 'Press P or click to resume');\n  else if (state === 'levelclear') drawOverlay('LEVEL ' + (level + 1) + ' CLEAR!', 'Click or press Space for level ' + (level + 2));\n  else if (state === 'gameover') drawOverlay('GAME OVER', 'Score: ' + score + ' — Click or press Space to restart');\n  else if (state === 'win') drawOverlay('YOU WIN!', 'Final score: ' + score + ' — Click or press Space to play again');\n}\n\nfunction loop() {\n  update();\n  draw();\n  requestAnimationFrame(loop);\n}\n\nloadLevel(0);\nloop();\n</script>\n</body>\n</html>\n"}}}
